<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homePanel"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="pepper" android:textSize="28sp" android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink" android:letterSpacing="-0.04" />
        <TextView android:id="@+id/statusText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:paddingStart="20dp" android:paddingEnd="10dp"
            android:text="Connexion au robot" android:textSize="14sp" android:textColor="@color/ink_2" />
        <Switch android:id="@+id/homeConversationSwitch" android:layout_width="wrap_content"
            android:layout_height="56dp" android:minWidth="120dp"
            android:text="Micro coupé  " android:textSize="14sp" android:textColor="@color/ink"
            android:thumbTint="@color/switch_thumb_color" android:trackTint="@color/switch_track_color" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:paddingEnd="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Un moment pour échanger." android:gravity="center"
                android:fontFamily="sans-serif-light" android:textSize="25sp" android:textColor="@color/ink"
                android:layout_marginTop="14dp" />
            <com.brutus.pepper.VoiceOrbView android:id="@+id/voiceOrb"
                android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:minHeight="100dp" android:contentDescription="Micro coupé" />
            <TextView android:id="@+id/voiceState" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center" android:text="Micro coupé"
                android:accessibilityLiveRegion="polite"
                android:textSize="23sp" android:fontFamily="sans-serif-medium" android:textColor="@color/ink" />
            <TextView android:id="@+id/voiceHint" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center"
                android:layout_marginTop="8dp" android:layout_marginBottom="14dp"
                android:text="Touchez Parler pour commencer." android:textSize="14sp" android:textColor="@color/ink_2" />
            <ProgressBar android:id="@+id/audioLevelBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="120dp" android:layout_height="3dp"
                android:max="100" android:progressTint="@color/blue" android:visibility="invisible"
                android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:padding="22dp"
            android:background="@drawable/conversation_card" android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="NOTRE CONVERSATION" android:letterSpacing="0.12"
                android:textSize="11sp" android:textColor="@color/ink_2" />
            <ScrollView android:id="@+id/chatScrollView" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1"
                android:fillViewport="true" android:clipToPadding="false"
                android:paddingTop="18dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:id="@+id/conversationEmpty" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="26dp"
                        android:text="Bonjour, je suis Pepper.\n\nUne question, une idée, une image à découvrir ? Parlons-en."
                        android:lineSpacingMultiplier="1.2" android:textSize="22sp"
                        android:fontFamily="sans-serif-light" android:textColor="@color/ink" />
                    <LinearLayout android:id="@+id/chatContainer" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical" />
                </LinearLayout>
            </ScrollView>
            <TextView android:id="@+id/liveTranscript" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="3"
                android:layout_marginTop="8dp" android:textColor="@color/blue_dark" android:textSize="18sp"
                android:visibility="gone" />
            <TextView android:id="@+id/voiceMetrics" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:paddingTop="10dp"
                android:text="Votre échange apparaît ici." android:textSize="12sp" android:textColor="@color/ink_2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
        <TextView android:id="@+id/stopButton" style="@style/ActionControl"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:text="Parler" android:textSize="19sp" />
        <TextView android:id="@+id/resetButton" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="16dp" android:background="@drawable/conversation_card"
            android:clickable="true" android:focusable="true" android:gravity="center"
            android:text="Nouvel échange" android:textSize="17sp" android:textColor="@color/ink" />
    </LinearLayout>
</LinearLayout>
