<?xml version="1.0" encoding="utf-8"?>
<!-- La page courante était impossible à identifier : les quatre entrées du rail
     avaient exactement la même apparence. Elle porte maintenant une pastille claire. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@color/blue_soft" />
        </shape>
    </item>
    <item><shape><corners android:radius="18dp" /><solid android:color="#00000000" /></shape></item>
</selector>
