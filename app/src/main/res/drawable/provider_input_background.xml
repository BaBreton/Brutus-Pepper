<?xml version="1.0" encoding="utf-8"?>
<!-- Champ de saisie. Le contour s'éclaire quand le champ a le focus : sur une tablette
     sans curseur visible, c'est le seul indice de l'endroit où le clavier écrit. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="2dp" android:color="@color/blue" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="#DDE5F4" />
        </shape>
    </item>
</selector>
