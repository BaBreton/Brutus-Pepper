<?xml version="1.0" encoding="utf-8"?>
<!-- Action principale. L'état désactivé reste bleu mais délavé : on doit voir que le
     bouton existe et qu'il est momentanément hors service, pas qu'il a disparu. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="#A8C2F0" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/blue_dark" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <solid android:color="@color/blue" />
        </shape>
    </item>
</selector>
